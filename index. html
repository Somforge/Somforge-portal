<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOMFORGE | Forging the Doctors of Tomorrow</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f7fa;
            color: #172b3a;
        }

        header {
            background: #102b3f;
            color: white;
            padding: 22px 8%;
        }

        .logo {
            font-size: 27px;
            font-weight: bold;
            letter-spacing: 2px;
        }

        .logo span {
            color: #e5b94c;
        }

        .hero {
            background: linear-gradient(135deg, #102b3f, #176078);
            color: white;
            padding: 100px 8%;
            text-align: center;
        }

        .hero h1 {
            font-size: 46px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 18px;
            line-height: 1.7;
            max-width: 650px;
            margin: 0 auto 30px;
        }

        .button {
            display: inline-block;
            background: #e5b94c;
            color: #102b3f;
            padding: 14px 30px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
        }

        .section {
            padding: 65px 8%;
            text-align: center;
        }

        .section h2 {
            font-size: 30px;
            margin-bottom: 15px;
        }

        .subjects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 35px;
        }

        .card {
            background: white;
            padding: 30px 20px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.07);
        }

        .card h3 {
            color: #176078;
            margin-bottom: 10px;
        }

        footer {
            background: #102b3f;
            color: white;
            padding: 25px;
            text-align: center;
        }

        @media (max-width: 600px) {
            .hero h1 {
                font-size: 34px;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="logo">SOM<span>FORGE</span></div>
</header>

<section class="hero">
    <h1>Forging the Doctors of Tomorrow</h1>

    <p>
        Welcome to SOMFORGE, a learning platform dedicated to helping
        medical students learn, understand and excel through quality
        academic resources and engaging lessons.
    </p>

    <a href="#courses" class="button">Explore Learning Areas</a>
</section>

<section class="section" id="courses">

    <h2>Our Learning Areas</h2>

    <p>Resources designed for Year 2 and Year 3 medical students.</p>

    <div class="subjects">

        <div class="card">
            <h3>Anatomy</h3>
            <p>Explore the structure of the human body.</p>
        </div>

        <div class="card">
            <h3>Biochemistry</h3>
            <p>Understand the chemistry of life.</p>
        </div>

        <div class="card">
            <h3>Physiology</h3>
            <p>Understand how the human body functions.</p>
        </div>

        <div class="card">
            <h3>Pathology</h3>
            <p>Study diseases and their mechanisms.</p>
        </div>

        <div class="card">
            <h3>Therapeutics</h3>
            <p>Learn the principles of disease treatment.</p>
        </div>

        <div class="card">
            <h3>Clinical Sciences</h3>
            <p>Develop foundational clinical knowledge and skills.</p>
        </div>

    </div>

</section>

<footer>
    <p>© 2026 SOMFORGE. Forging the Doctors of Tomorrow.</p>
</footer>

</body>
<!-- SOMFORGE deployment test -->
</html>
